<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1" xmlns:vm="clr-namespace:WpfApp1.ViewModels"
        mc:Ignorable="d"
        Title="ModBus上位机Demo" Height="450" Width="800">
    <Window.DataContext>
        <vm:MainViewModel/><!--这就是绑定-->
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/><!--分区?-->
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <CheckBox Content="TCP" IsChecked="{Binding UseTcp}" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="IP:" VerticalAlignment="Center"/><!-- 文本块 -->
            <TextBlock Text="{Binding Ip}" Width="120" Margin="4,0"/>
            <TextBlock Text="Port:" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Port}" Width="60" Margin="4,0"/>
            <Button Content="连接" Command="{Binding ConnectCmd}" Width="80" Margin="10,0,4,0"/>
            <Button Content="断开" Command="{Binding DisconnectCmd}" Width="80"/>
            <TextBlock Text="状态:" VerticalAlignment="Center" Margin="20,0,4,0"/>
            <TextBlock Text="{Binding IsConnected}" VerticalAlignment="Center" Foreground="Green"/>
            
            <ComboBox ItemsSource="{Binding TagNames}"
              SelectedItem="{Binding SelectedTagName}"
              Width="120" Margin="4,0"/>
            <Button Content="查历史" Command="{Binding ReadHistory}" Width="80" Margin="8,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Points}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="80"/>
                <DataGridTextColumn Header="值" Binding="{Binding Value,StringFormat=F2}" Width="100"/>
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="80"/>

                <DataGridTemplateColumn Header="输入值/MPa" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding WriteValue, StringFormat=F2, UpdateSourceTrigger=LostFocus}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="操作" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="写" Width="50"
                                    Command="{Binding DataContext.WriteCmd, RelativeSource= {RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        
        <ListBox Grid.Row="2" ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="12"/>
    </Grid>
</Window>
